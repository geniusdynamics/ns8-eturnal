# If the control reaches this step, the service can be enabled and started

set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# A failed service is not active, so try-restart would leave it down after a
# successful retry. Only configured (enabled) instances should be started.
if systemctl --user --quiet is-enabled eturnal.service; then
    systemctl --user restart eturnal.service
fi
